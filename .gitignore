# ============================================
# 🐳 DOCKER / DOCKER-COMPOSE
# ============================================
# Локальные переопределения конфигурации (не коммитим)
docker-compose.override.yml
docker-compose.local.yml

# Артефакты экспорта/импорта образов
*.tar
*.tar.gz
*.dockerignore

# Папка с локальными настройками Docker
.docker/

# ============================================
# 🗄️ БАЗЫ ДАННЫХ / ДАМПЫ (как ты просил)
# ============================================
# Дампы баз данных (тяжёлые, часто меняются)
*.dump
*.backup
*.sql.gz
*.sql.bz2

# Исключение: оставляем скрипты инициализации, которые нужны для проекта
!services/database/init.sql
!services/*/src/main/resources/data.sql
!services/session-service/src/main/resources/data.sql
!services/hotel-service/src/main/resources/data.sql

# ============================================
# 🗜️ АРХИВЫ И РЕЗЕРВНЫЕ КОПИИ (как ты просил)
# ============================================
*.zip
*.rar
*.7z
*.bz2
*.xz
*.gz
*.zst

# ============================================
# ☕ JAVA / MAVEN — ДОПОЛНИТЕЛЬНО
# ============================================
# Скомпилированные артефакты (если вдруг появятся вне target/)
*.jar
*.war
*.ear
*.nar

# Папки сборки для Gradle (на всякий случай)
build/
.gradle/

# Локальный репозиторий Maven (если кто-то положит в проект)
.m2/
repository/

# ============================================
# 🧪 ТЕСТЫ / ОТЧЁТЫ / ПОКРЫТИЕ
# ============================================
# Отчёты о покрытии кода (генерируются тестами)
coverage/
jacoco.exec
*.exec
*.coverage

# Отчёты в бинарных форматах (наш отчёт — только .md)
*.pdf
*.docx
*.odt
*.rtf

# ============================================
# 🗂️ ПРОЕКТНЫЙ СПЕЦИФИЧНЫЙ МУСОР
# ============================================
# Вывод скрипта дампа (генерируется, не нужен в гите)
project_dump.txt

# Логи работающих сервисов (если кто-то перенаправил вывод в файл)
logs/
*.log
spring.log
hibernate.log

# Временные файлы скриптов
*.pid
*.lock
*.tmp
*.temp

# ============================================
# 🔐 СЕКРЕТЫ / ОКРУЖЕНИЕ
# ============================================
# Файлы с паролями и ключами (НИКОГДА не коммитим!)
*.pem
*.key
*.crt
*.p12
*.jks
secrets/
credentials/

# Локальные конфиги с чувствительными данными
*-local.properties
*-dev.properties
*.env.local
*.env.production

# ============================================
# 🗑️ ВИРТУАЛИЗАЦИЯ / VAGRANT
# ============================================
# Состояние ВМ (уже есть .vagrant/, но добавим артефакты)
*.box
*.iso
*.ova
*.ovf

# ============================================
# ✅ ЧТО ОСТАВЛЯЕМ (для понимания)
# ============================================
# Оставляем:
# - Исходный код (*.java)
# - Конфиги сборки (pom.xml)
# - Docker-конфиги (docker-compose.yml, Dockerfile)
# - Vagrantfile
# - Отчёт проекта: src/REPORT.MD
# - Скрипты инициализации БД (init.sql, data.sql)
# - Postman коллекцию: application_tests.postman_collection.json
# - Скрипты: wait-for-it.sh, dump_all_files.sh